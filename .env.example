# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=5687
DEBUG=false

# Dashboard login (set your own values; generate SESSION_SECRET with: openssl rand -hex 32)
LOGIN_USERNAME=
LOGIN_PASSWORD=
SESSION_SECRET=
SESSION_COOKIE_SECURE=false
AGENTS_API_USERNAME=
AGENTS_API_PASSWORD=

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USER=agents_hotline_user
DB_PASSWORD=agents_hotline_password
DB_NAME=agents_hotline_db

# Database URL (alternative to individual settings)
# DATABASE_URL=mysql+pymysql://agents_hotline_user:agents_hotline_password@mysql:3306/agents_hotline_db

# MySQL Root Password
MYSQL_ROOT_PASSWORD=RootPass123!

# Webhook Configuration (can be overridden via Settings API)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=5687
WEBHOOK_PATH=/webhook/agents

# CORS
CORS_ORIGINS=["http://localhost:5686", "http://100.66.60.70:5686", "http://100.122.130.97:5686"]

# Logging
LOG_LEVEL=INFO